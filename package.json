{
  "name": "nouraldin-farge-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "export:pages": "npm run build && node scripts/export-github-pages.mjs",
    "export:pages:release": "npm run build && node scripts/export-github-pages.mjs --require-clean",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/static-html.test.mjs tests/static-export.test.mjs tests/accessibility.test.mjs",
    "test:a11y": "npm run build && node --test tests/accessibility.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "axe-core": "4.14.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "parse5": "8.1.0",
    "playwright": "1.65.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vinext": "^1.4.4",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "type": "module"
}
